#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC    &kp N1  &kp N2    &kp N3    &kp N4  &kp N5                                                &kp N6  &kp N7    &kp N8     &kp N9    &kp N0    &kp GRAVE
&kp TAB    &kp Q   &kp W     &kp E     &kp R   &kp T                                                 &kp Y   &kp U     &kp I      &kp O     &kp P     &kp MINUS
&kp LSHFT  &kp A   &kp S     &kp D     &kp F   &kp G                                                 &kp H   &kp J     &kp K      &kp L     &kp SEMI  &kp SQT
&kp LCTRL  &kp Z   &kp X     &kp C     &kp V   &kp B   &trans     &caps_word    &trans  &trans       &kp N   &kp M     &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
&kp LCTRL          &kp LALT  &kp LGUI  &mo 3           &lt 1 RET  &trans        &trans  &lt 2 SPACE          &kp BSPC  &kp DEL    &kp RGUI            &kp L
            >;

            sensor-bindings =
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>,
                <&inc_dec_kp C D>;
        };

        lower {
            bindings = <
&trans     &trans    &trans       &trans    &trans      &trans                                         &trans     &trans     &trans        &trans                &trans                 &trans
&kp F1     &kp F2    &kp F3       &kp F4    &kp F5      &kp F6                                         &kp F7     &kp F8     &kp F9        &kp F10               &kp F11                &kp F12
&kp GRAVE  &kp EXCL  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                                    &kp CARET  &kp AMPS   &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans     &trans    &trans       &trans    &trans      &trans       &trans  &trans    &trans  &trans  &trans     &kp MINUS  &kp PLUS      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE
&trans               &trans       &trans    &trans                   &trans  &trans    &trans  &trans             &trans     &trans        &trans                                       &trans
            >;
        };

        raise {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                                    &kp PSCRN    &kp SLCK        &kp PAUSE_BREAK  &trans            &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans                                    &kp INSERT   &kp HOME        &kp PG_DN        &kp PAGE_UP       &kp END            &trans
&trans  &trans  &trans  &trans  &trans  &trans                                    &trans       &kp LEFT_ARROW  &kp DOWN_ARROW   &kp UP_ARROW      &kp RIGHT_ARROW    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &kp KP_PLUS  &kp MINUS       &kp EQUAL        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BSLH
&trans          &trans  &trans  &trans          &trans  &trans    &trans  &trans               &trans          &trans           &trans                               &trans
            >;
        };

        system {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                        &kp C_PREV      &kp C_PP         &kp C_NEXT      &trans           &trans  &kp C_VOLUME_UP
&trans      &trans        &trans        &trans        &trans        &trans                                              &msc SCRL_UP    &mkp MB1         &mmv MOVE_UP    &mkp MB2         &trans  &kp C_VOL_DN
&trans      &trans        &trans        &trans        &trans        &trans                                              &msc SCRL_DOWN  &mmv MOVE_LEFT   &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans  &kp C_MUTE
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &kp C_MUTE    &trans  &trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &trans          &trans           &trans  &trans
&trans                    &trans        &trans        &trans                      &trans  &trans        &trans  &trans                  &trans           &trans          &trans                   &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };
    };
};
